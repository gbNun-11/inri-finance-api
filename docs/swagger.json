{
  "openapi": "3.0.0",
  "info": {
    "title": "INRI Finance API",
    "description": "API for INRI Finance documentation",
    "version": "1.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:8030/api",
      "description": "Local server"
    },
    {
      "url": "https://inrifinance-api.onrender.com/api",
      "description": "Production server"
    }
  ],
  "paths": {
    "/users": {
      "post": {
        "summary": "Create a new user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "security": [],
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user creation data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingFirstName": {
                    "summary": "Missing first name",
                    "value": {
                      "errorMessage": "Missing param: first_name"
                    }
                  },
                  "missingLastName": {
                    "summary": "Missing last name",
                    "value": {
                      "errorMessage": "Missing param: last_name"
                    }
                  },
                  "missingEmail": {
                    "summary": "Missing e-mail",
                    "value": {
                      "errorMessage": "Missing param: email"
                    }
                  },
                  "invalidEmail": {
                    "summary": "Invalid e-mail",
                    "value": {
                      "errorMessage": "Invalid e-mail. Please provide a valid one"
                    }
                  },
                  "missingPassword": {
                    "summary": "Missing password",
                    "value": {
                      "errorMessage": "Missing param: password"
                    }
                  },
                  "shortPassword": {
                    "summary": "Short password",
                    "value": {
                      "errorMessage": "Password must be at least 6 characters"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "E-mail already in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "The e-mail john.doe@example.com is already in use"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get authenticated user",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingUserId": {
                    "summary": "Missing user ID",
                    "value": {
                      "errorMessage": "User ID is required"
                    }
                  },
                  "invalidUserId": {
                    "summary": "Invalid user ID",
                    "value": {
                      "errorMessage": "User ID is not valid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "User not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/users/me/balance": {
      "get": {
        "summary": "Get authenticated user balance",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Optional start date to filter transactions from a specific date (format: YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-04-01"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Optional end date to filter transactions up to a specific date (format: YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-04-30"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User balance found successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBalance"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidUserId": {
                    "value": {
                      "errorMessage": "User ID is not valid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "User not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and return access token",
        "tags": ["Authenticate"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "user": {
                    "id": "2e4d4d19-67e8-479a-b109-994bf5433d26",
                    "first_name": "Jon",
                    "last_name": "Doe",
                    "email": "john.doe@example.com"
                  },
                  "tokens": {
                    "accessToken": "2e4d4d19-67e8-479a-b109-994bf5433d26343",
                    "refreshToken": "2e4d4d19-67e8-479a-b109-994bf5433d2245"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidCredentials": {
                    "value": {
                      "errorMessage": "Invalid email or password."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh-token": {
      "post": {
        "summary": "Validate the refresh token and return access token",
        "tags": ["Authenticate"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshToken"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access Token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                },
                "example": {
                  "accessToken": "2e4d4d19-67e8-479a-b109-994bf5433d26343"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidCredentials": {
                    "value": {
                      "errorMessage": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/me": {
      "post": {
        "summary": "Create a new transaction for the authenticated user",
        "tags": ["Transactions"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction creation data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingName": {
                    "summary": "Missing name",
                    "value": {
                      "errorMessage": "Missing param: name"
                    }
                  },
                  "missingDate": {
                    "summary": "Missing date",
                    "value": {
                      "errorMessage": "Missing param: date"
                    }
                  },
                  "missingAmount": {
                    "summary": "Missing amount",
                    "value": {
                      "errorMessage": "Missing param: amount"
                    }
                  },
                  "invalidAmountType": {
                    "summary": "Invalid amount type",
                    "value": {
                      "errorMessage": "The type amount must be number."
                    }
                  },
                  "invalidAmount": {
                    "summary": "Invalid amount",
                    "value": {
                      "errorMessage": "The amount must be greater than 0."
                    }
                  },
                  "missingType": {
                    "summary": "Missing type",
                    "value": {
                      "errorMessage": "Missing param: type"
                    }
                  },
                  "invalidType": {
                    "summary": "Invalid transaction type",
                    "value": {
                      "errorMessage": "The type must be EARNING, EXPENSE or INVESTMENT"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "User not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get authenticated user transactions",
        "tags": ["Transactions"],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Optional start date to filter transactions from a specific date (format: YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-04-01"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Optional end date to filter transactions up to a specific date (format: YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-04-30"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingUserId": {
                    "summary": "Missing user ID",
                    "value": {
                      "errorMessage": "User ID is required"
                    }
                  },
                  "invalidUserId": {
                    "summary": "Invalid user ID",
                    "value": {
                      "errorMessage": "User ID is not valid"
                    }
                  },
                  "invalidFromDate": {
                    "summary": "Invalid from date",
                    "value": {
                      "errorMessage": "Invalid from date. Use format YYYY-MM-DD"
                    }
                  },
                  "invalidToDate": {
                    "summary": "Invalid to date",
                    "value": {
                      "errorMessage": "Invalid to date. Use format YYYY-MM-DD"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Transactions not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Transactions not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/me/{transactionId}": {
      "patch": {
        "summary": "Update authenticated user transaction",
        "tags": ["Transactions"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Transaction UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction update data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingTransactionId": {
                    "summary": "Missing transaction ID",
                    "value": {
                      "errorMessage": "Transaction ID is required"
                    }
                  },
                  "invalidTransactionId": {
                    "summary": "Invalid transaction ID",
                    "value": {
                      "errorMessage": "Transaction ID is not valid"
                    }
                  },
                  "emptyUpdateBody": {
                    "summary": "Empty update body",
                    "value": {
                      "errorMessage": "At least one field must be provided to update the transaction"
                    }
                  },
                  "invalidAmountType": {
                    "summary": "Invalid amount type",
                    "value": {
                      "errorMessage": "The type amount must be number."
                    }
                  },
                  "invalidAmount": {
                    "summary": "Invalid amount",
                    "value": {
                      "errorMessage": "The amount must be greater than 0."
                    }
                  },
                  "invalidType": {
                    "summary": "Invalid transaction type",
                    "value": {
                      "errorMessage": "The type must be EARNING, EXPENSE or INVESTMENT"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Transaction not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete  authenticated user transaction",
        "tags": ["Transactions"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Transaction UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Transaction deleted successfully"
          },
          "400": {
            "description": "Invalid transaction ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingTransactionId": {
                    "summary": "Missing transaction ID",
                    "value": {
                      "errorMessage": "Transaction ID is required"
                    }
                  },
                  "invalidTransactionId": {
                    "summary": "Invalid transaction ID",
                    "value": {
                      "errorMessage": "Transaction ID is not valid"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Transaction not found."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "errorMessage": "Internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token"
      }
    },
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "required": ["first_name", "last_name", "email", "password"],
        "properties": {
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecurePassword123"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "74f0e35a-68d0-4493-a901-1ec03517cd6a"
          },
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "tokens": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "refreshToken": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              }
            }
          }
        }
      },
      "UserBalance": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "earning": {
            "type": "string",
            "example": "3900.00"
          },
          "expense": {
            "type": "string",
            "example": "1400.00"
          },
          "investment": {
            "type": "string",
            "example": "1500.00"
          },
          "balance": {
            "type": "string",
            "example": "1000.00"
          },
          "earning_percentage": {
            "type": "string",
            "example": "57.35"
          },
          "expense_percentage": {
            "type": "string",
            "example": "20.58"
          },
          "investment_percentage": {
            "type": "string",
            "example": "22.05"
          }
        }
      },
      "LoginUser": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecurePassword123"
          }
        }
      },
      "RefreshToken": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "tokens": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "refreshToken": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              }
            }
          }
        }
      },
      "RefreshTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "required": ["name", "date", "amount", "type"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Salary"
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-04-24"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 2500.75
          },
          "type": {
            "type": "string",
            "enum": ["EARNING", "EXPENSE", "INVESTMENT"],
            "example": "EARNING"
          }
        }
      },
